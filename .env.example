# Copy this file to .env to change settings. Never commit .env.

# Each person enters their own Meta Model API key in the studio (it stays in their browser).
# MODEL_API_KEY is only read by `storeel make`, the command-line run, for your own key.
MODEL_API_KEY=

# Everything below is optional; the defaults are shown.
# META_API_BASE_URL=https://api.meta.ai/v1

# Where projects, uploads, renders and the job database are stored.
# STOREEL_DATA_DIR=./data

# Two text models: one writes the scripts, one watches the video and plans the pictures.
# The defaults won a comparison on the real API: Muse Spark wrote the more reliable scripts,
# Muse Wonder the better picture plans (it recognises the speaker and fits the pictures to
# the framing). Muse Wonder costs $4 / $20 per 1M input / output tokens, Muse Spark $1.25 /
# $4.25. The "-contributor" Muse Spark variants cost less, but Meta may train on everything
# you send, so do not use them for other people's videos.
# STOREEL_SCRIPT_MODEL=muse-spark-1.3
# STOREEL_SCRIPT_EFFORT=max              # minimal | low | medium | high | xhigh | max
# A novel part is written while its creator waits: "high" answers in about 45 s, "max" can
# take many minutes. A part whose answer stalls is tried again one level lower.
# STOREEL_PART_EFFORT=high
# STOREEL_PLAN_MODEL=muse-wonder-1.0
# STOREEL_PLAN_EFFORT=max
# Cap on each text-model answer, reasoning included. Stops a runaway answer (seen once:
# 19,700 tokens of junk text) from running up the bill: at most $0.64 a call on Muse Wonder.
# STOREEL_MAX_OUTPUT_TOKENS=32000

# Checks on a novel part. A text model looks at each new character portrait and redraws a
# wrong one once (well under a cent a look, plus $0.0125 a redraw), and reviews a new part's
# storyboard against the chapter (one more call, then one rewrite if it finds mismatches).
# STOREEL_CHECK_MODEL=muse-spark-1.3
# STOREEL_PICTURE_CHECK_EFFORT=low       # minimal ... max, or off
# STOREEL_STORY_REVIEW_EFFORT=high       # minimal ... max, or off

# The editing agent (the chat on a reel's page). It edits captions, pictures and the style
# from a request; new pictures and renders wait for the user's approval.
# STOREEL_AGENT_MODEL=muse-spark-1.3
# STOREEL_AGENT_EFFORT=low               # minimal ... max

# STOREEL_IMAGE_MODEL=muse-image-1.0
# STOREEL_IMAGE_REASONING=high         # low = one pass (faster), high = refined (same price)
# STOREEL_IMAGE_PARALLEL=4             # images generated at the same time

# STOREEL_ASR_MODEL=muse-voice-transcribe-1.0
# STOREEL_SAM_MODEL=sam-3.1

# STOREEL_MAX_INPUT_SECONDS=180        # total length of the clips in one reel
# STOREEL_MAX_UPLOAD_MB=1024           # per uploaded file
# STOREEL_WORKERS=2                    # background jobs that run at the same time

# Extra host names allowed to reach the local server, comma-separated (e.g. a tunnel
# used to record on a phone). localhost and 127.0.0.1 are always allowed.
# STOREEL_ALLOWED_HOSTS=

# Hosting the studio for other people (modal_app.py sets these). With private projects on,
# each browser sees and changes only the reels and novels it made: there is no login, so the
# owner is a random id kept in a cookie. Showcase ids (reels or novels, comma-separated) can be
# watched by everyone and changed by no one, and the cleanup never deletes them. The TTL deletes
# every other reel and novel left untouched that many hours (0 keeps everything).
# STOREEL_PRIVATE_PROJECTS=0
# STOREEL_SHOWCASE=
# STOREEL_TTL_HOURS=0

# The motion graphics renderer (HyperFrames, run locally; see README). By default the studio
# uses motion/node_modules/.bin/hyperframes when `cd motion && npm ci` has installed it; set a
# path to use another install, or "off" for plain entrances.
# STOREEL_HYPERFRAMES=
