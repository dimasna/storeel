# Copy this file to .env and fill in MODEL_API_KEY. Never commit .env.

# Meta Model API key, created in the Model API dashboard (https://dev.meta.ai). Required.
MODEL_API_KEY=

# Everything below is optional; the defaults are shown.
# META_API_BASE_URL=https://api.meta.ai/v1

# Where projects, uploads, renders and the job database are stored.
# STOREEL_DATA_DIR=./data

# Muse Spark writes scripts and plans the visuals. The "-contributor" variants cost less,
# but Meta may train on everything you send, so do not use them for other people's videos.
# STOREEL_SPARK_MODEL=muse-spark-1.3
# STOREEL_SPARK_EFFORT=medium          # minimal | low | medium | high | xhigh | max

# STOREEL_IMAGE_MODEL=muse-image-1.0
# STOREEL_IMAGE_REASONING=high         # low = one pass (faster), high = refined (same price)
# STOREEL_IMAGE_PARALLEL=4             # images generated at the same time

# STOREEL_ASR_MODEL=muse-voice-transcribe-1.0
# STOREEL_SAM_MODEL=sam-3.1

# STOREEL_MAX_INPUT_SECONDS=180        # total length of the clips in one reel
# STOREEL_MAX_UPLOAD_MB=1024           # per uploaded file
# STOREEL_WORKERS=2                    # background jobs that run at the same time

# Extra host names allowed to reach the local server, comma-separated (e.g. a tunnel
# used to record on a phone). localhost and 127.0.0.1 are always allowed.
# STOREEL_ALLOWED_HOSTS=
