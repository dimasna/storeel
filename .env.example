# Copy this file to .env to change settings. Never commit .env.

# Each person enters their own Meta Model API key in the studio (it stays in their browser).
# MODEL_API_KEY is only read by `storeel make`, the command-line run, for your own key.
MODEL_API_KEY=

# Everything below is optional; the defaults are shown.
# META_API_BASE_URL=https://api.meta.ai/v1

# Where projects, uploads, renders and the job database are stored.
# STOREEL_DATA_DIR=./data

# The text model writes scripts and plans the pictures. The default is Muse Wonder at "max"
# effort: the most capable setting, and the most expensive ($4 in / $20 out per 1M tokens,
# about 5x Muse Spark; "max" also thinks the longest). For cheaper, faster runs use
# muse-spark-1.3 with medium. The "-contributor" Muse Spark variants cost less still, but Meta
# may train on everything you send, so do not use them for other people's videos.
# STOREEL_TEXT_MODEL=muse-wonder-1.0     # or muse-spark-1.3, muse-spark-1.2, ...
# STOREEL_TEXT_EFFORT=max                # minimal | low | medium | high | xhigh | max

# STOREEL_IMAGE_MODEL=muse-image-1.0
# STOREEL_IMAGE_REASONING=high         # low = one pass (faster), high = refined (same price)
# STOREEL_IMAGE_PARALLEL=4             # images generated at the same time

# STOREEL_ASR_MODEL=muse-voice-transcribe-1.0
# STOREEL_SAM_MODEL=sam-3.1

# STOREEL_MAX_INPUT_SECONDS=180        # total length of the clips in one reel
# STOREEL_MAX_UPLOAD_MB=1024           # per uploaded file
# STOREEL_WORKERS=2                    # background jobs that run at the same time

# Extra host names allowed to reach the local server, comma-separated (e.g. a tunnel
# used to record on a phone). localhost and 127.0.0.1 are always allowed.
# STOREEL_ALLOWED_HOSTS=
